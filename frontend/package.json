{
  "name": "@tcm/frontend",
  "private": true,
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test test/*.test.mjs",
    "build:web": "expo export -p web --output-dir ../tcm-web"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "expo": "~57.0.0",
    "expo-auth-session": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.15",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.16",
    "expo-sharing": "~57.0.17",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "expo-video": "~57.0.3",
    "expo-video-thumbnails": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@babel/core": "^7.26.0",
    "babel-preset-expo": "~57.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native",
        "react-native-web"
      ]
    }
  }
}
